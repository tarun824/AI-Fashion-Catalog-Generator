OPENAI_API_KEY=your_openai_key_here
PORT=5000
OPENAI_VISION_MODEL=gpt-4o-mini
MAX_BATCH_SIZE=200
MAX_IMAGE_MB=10
WORKER_CONCURRENCY=4
ALLOWED_ORIGINS=http://localhost:5173
DESCRIPTION_PROMPT=Review this garment image and fill every bullet. Favor exact fashion terminology.
ESTIMATE_IMAGE_SECONDS=20
EXPORT_DESCRIPTION_LINES=4

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/fashion-catalog
MONGODB_GRIDFS_BUCKET=product-images

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Default Admin Credentials (change after first login)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Shiprocket Integration (Shipping Automation)
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_API_BASE=https://apiv2.shiprocket.in/v1/external

# Flipkart Marketplace Integration
FLIPKART_API_KEY=your-flipkart-api-key
FLIPKART_APP_ID=your-flipkart-app-id
FLIPKART_SELLER_ID=your-seller-id

# Amazon Marketplace Integration
AMAZON_SELLER_ID=your-amazon-seller-id
AMAZON_ACCESS_KEY=your-amazon-access-key
AMAZON_SECRET_KEY=your-amazon-secret-key
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# WhatsApp Business API
WHATSAPP_BUSINESS_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Backend URL (for webhook generation)
BACKEND_URL=http://localhost:5000

# Customer Intelligence Thresholds
VIP_SPENT_THRESHOLD=50000
VIP_ORDERS_THRESHOLD=10
REGULAR_ORDERS_THRESHOLD=3
INACTIVE_DAYS=90

# Price Configuration
DEFAULT_MAX_PRICE=50000

# Testing/Development
SHIPROCKET_MOCK_MODE=false
NODE_ENV=development
